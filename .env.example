# ============================================
# 企业级 AI 智能问答系统 - 环境变量配置
# 复制此文件为 .env 并修改
# ============================================

# --- 数据库 ---
POSTGRES_USER=aiqa
POSTGRES_PASSWORD=aiqa_secure_pass_2026
POSTGRES_DB=aiqa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (对话缓存) ---
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=aiqa_redis_pass_2026
REDIS_CONV_TTL=7200

# --- MinIO ---
MINIO_ROOT_USER=aiqa_admin
MINIO_ROOT_PASSWORD=aiqa_minio_pass_2026
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=aiqa-documents

# --- Milvus ---
MILVUS_HOST=localhost
MILVUS_PORT=19530

# --- 关键词检索 ---
# 可选: milvus (利用Milvus BM25) | pgvector (PostgreSQL FTS) | simple (内置BM25)
KEYWORD_STORE_TYPE=milvus

# ============ LLM 主模型 (三选一) ============

# 方案 A: 本地 vLLM (默认)
LLM_PRIMARY_PROVIDER=vllm
LLM_VLLM_BASE=http://localhost:8000/v1
LLM_VLLM_MODEL=deepseek-r1

# 方案 B: DeepSeek 官方 API (远程)
# LLM_PRIMARY_PROVIDER=deepseek
# LLM_DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# LLM_DEEPSEEK_MODEL=deepseek-chat

# 方案 C: OpenAI 兼容 API (远程)
# LLM_PRIMARY_PROVIDER=openai
# LLM_OPENAI_BASE=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=sk-your-openai-api-key
# LLM_OPENAI_MODEL=gpt-4o-mini

# ============ LLM 备用模型 (主模型不可用时自动切换) ============

LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=deepseek
# 如果备用是 DeepSeek，配置:
LLM_DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ============ LLM 通用 ============

LLM_MAX_TOKENS=8192
LLM_MAX_TOTAL_TOKENS=16384
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_CIRCUIT_BREAKER_THRESHOLD=3

# --- 对话历史 ---
MAX_VERBATIM_ROUNDS=6
KEEP_RECENT_ROUNDS=2

# --- Embedding ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cuda

# --- Reranker ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda

# --- Pipeline ---
PIPELINE_TYPE=naive-rag

# --- 应用 ---
APP_NAME=AI-QA-System
APP_PORT=8001
APP_LOG_LEVEL=info
APP_LOG_FORMAT=console  # console | json (生产环境建议 json)
APP_SECRET_KEY=change-this-to-a-random-secret-key

# --- CORS (生产环境必须配置) ---
# 逗号分隔的允许来源，例如: http://localhost:3000,https://your-domain.com
CORS_ALLOWED_ORIGINS=*

# --- JWT (生产环境必须修改) ---
# ⚠️ 警告: 生产环境必须使用复杂随机字符串替换此默认值！
JWT_SECRET=change-this-to-a-secure-jwt-secret
JWT_EXPIRY_HOURS=24

# ============ OpenTelemetry 链路追踪 ============
# 启用 OpenTelemetry 分布式追踪
OTEL_ENABLED=true
# OTLP 导出端 (留空 = 仅日志输出, 不发送到 Collector)
# 例如: http://localhost:4317 (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=
